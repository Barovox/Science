@{
  ViewBag.Title = "Cài đặt hệ thống";
  Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<div class="pagetitle">
  <h1>Cài đặt hệ thống</h1>
</div>

<section class="section">
  <div class="row">
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title mb-0">Năm học</h5>
          <p class="card-subtitle">Tùy chỉnh thời gian bắt đầu - kết thúc của năm học</p>
          
          <form class="row g-3 mt-2" onsubmit="capNhatNamHoc(event)">
            <div class="col-md-6">
              <label for="dateStart" class="form-label">Ngày bắt đầu (năm này)</label>
              <input type="number" class="form-control" id="dateStart" value="1" min="1" max="31" required>
            </div>
            <div class="col-md-6">
              <label for="monthStart" class="form-label">Tháng bắt đầu (năm này)</label>
              <input type="number" class="form-control" id="monthStart" value="1" min="1" max="12" required>
            </div>
            <div class="col-md-6">
              <label for="dateEnd" class="form-label">Ngày kết thúc (năm sau)</label>
              <input type="number" class="form-control" id="dateEnd" value="1" min="1" max="31" required>
            </div>
            <div class="col-md-6">
              <label for="monthEnd" class="form-label">Tháng kết thúc (năm sau)</label>
              <input type="number" class="form-control" id="monthEnd" value="1" min="1" max="12" required>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title mb-0">Xuất công trình</h5>
          
          <form class="row g-3" onsubmit="capNhatXuatDMXD(event)">
            <div class="col-md-6">
              <label for="xuatDMXD" class="form-label">Xuất công trình theo</label>
              <select class="form-control" id="xuatDMXD" required>
                <option value="dateSubmit">Ngày công bố</option>
                <option value="dateSubmit_now">Ngày kê khai</option>
              </select>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title mb-0">Cài đặt kê khai</h5>
          
          <form class="row g-3" onsubmit="capNhatCaiDatKeKhai(event)">
            <div class="md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="toggleKeKhaiDeTai" checked>
                <label class="form-check-label" for="toggleKeKhaiDeTai">Cho phép kê khai sản phẩm KHCN</label>
              </div>
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="toggleKeKhaiDeTaiSinhVien" checked>
                <label class="form-check-label" for="toggleKeKhaiDeTaiSinhVien">Cho phép kê khai đề tài KHCN cấp Trường</label>
              </div>
            </div>

            <div class="text-center">
              <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            </div>
          </form>
        </div>
      </div>
    </div>
    
    <div class="col-lg-6">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">Sớm có...</h5>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function getNamHoc() {
    fetch('https://localhost:44364/api/CaiDatHeThong/Get-NamHoc', {
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      }
    })
      .then(response => response.json())
      .then(data => {
        const value = JSON.parse(data[0].value);
        
        document.getElementById("dateStart").value = value.dateStart;
        document.getElementById("monthStart").value = value.monthStart;
        document.getElementById("dateEnd").value = value.dateEnd;
        document.getElementById("monthEnd").value = value.monthEnd;
      })
  }
  
  function getXuatDMXD() {
    fetch('https://localhost:44364/api/CaiDatHeThong/Get-XuatDMXD', {
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      }
    })
      .then(response => response.json())
      .then(data => {
        document.getElementById("xuatDMXD").value = data[0].value;
      })
  }
  
  function getCaiDatKeKhai() {
    fetch('https://localhost:44364/api/CaiDatHeThong/Get-CaiDatKeKhai', {
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      }
    })
      .then(response => response.json())
      .then(data => {
        const value = JSON.parse(data[0].value);
        
        document.getElementById("toggleKeKhaiDeTai").checked = value.keKhaiDeTai;
        document.getElementById("toggleKeKhaiDeTaiSinhVien").checked = value.keKhaiDeTaiSinhVien;
      })
  }

  document.addEventListener("DOMContentLoaded", function () {
    getNamHoc();
    getXuatDMXD();
    getCaiDatKeKhai();
  });

  function capNhatNamHoc(e) {
    e.preventDefault();

    const dateStart = document.getElementById("dateStart").value;
    const monthStart = document.getElementById("monthStart").value;
    const dateEnd = document.getElementById("dateEnd").value;
    const monthEnd = document.getElementById("monthEnd").value;
    
    const value = JSON.stringify({
      dateStart: dateStart,
      monthStart: monthStart,
      dateEnd: dateEnd,
      monthEnd: monthEnd,
    })

    fetch('https://localhost:44364/api/CaiDatHeThong/Save-NamHoc', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(value),
    })
      .then(response => {
        if (response.ok) {
          alert('Cập nhật dữ liệu năm học thành công!');
          // Đóng modal
          $('#modal-lg-create').modal('hide');

          // Load lại trang
          location.reload();
        } else {
          console.log(response);
          alert('Có lỗi');
        }
      });
  }

  function capNhatXuatDMXD(e) {
    e.preventDefault();

    const value = document.getElementById("xuatDMXD").value;

    fetch('https://localhost:44364/api/CaiDatHeThong/Save-XuatDMXD', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(value),
    })
      .then(response => {
        if (response.ok) {
          alert('Cập nhật dữ liệu xuất công trình thành công!');
          // Đóng modal
          $('#modal-lg-create').modal('hide');

          // Load lại trang
          location.reload();
        } else {
          console.log(response);
          alert('Có lỗi');
        }
      });
  }

  function capNhatCaiDatKeKhai(e) {
    e.preventDefault();

    const keKhaiDeTai = document.getElementById("toggleKeKhaiDeTai").checked;
    const keKhaiDeTaiSinhVien = document.getElementById("toggleKeKhaiDeTaiSinhVien").checked;
    
    const value = JSON.stringify({
      keKhaiDeTai: keKhaiDeTai,
      keKhaiDeTaiSinhVien: keKhaiDeTaiSinhVien,
    })

    fetch('https://localhost:44364/api/CaiDatHeThong/Save-CaiDatKeKhai', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(value),
    })
      .then(response => {
        if (response.ok) {
          alert('Cập nhật cài đặt kê khai thành công!');
          // Đóng modal
          $('#modal-lg-create').modal('hide');

          // Load lại trang
          location.reload();
        } else {
          console.log(response);
          alert('Có lỗi');
        }
      });
  }
</script>
