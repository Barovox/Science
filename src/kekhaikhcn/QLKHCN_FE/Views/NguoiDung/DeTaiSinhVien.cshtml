<script>
    // không cho phép nhập nhỏ hơn 5 hoặc lớn hơn 12
    document.getElementById('tgThucHien').addEventListener('input', function () {
        var value = parseInt(this.value);
        var min = parseInt(this.min);
        var max = parseInt(this.max);
    
        if (value < min) {
            this.value = min;
        } else if (value > max) {
            this.value = max;
        }
    });
    
    function countWords(textarea) {
      const originalText = textarea.value;
    
      // Lọc ra từ hợp lệ (chỉ chữ, số, tiếng Việt)
      const validWords = originalText
        .replace(/[^0-9A-Za-zÀ-ỹ\s]/g, " ") // ký tự đặc biệt → dấu cách
        .trim()
        .split(/\s+/)
        .filter(w => w.length > 0);
    
      // Giới hạn 100 từ cho việc đếm (không giới hạn nhập)
      const wordCount = Math.min(validWords.length, 100);
    
      // Hiển thị số từ
      document.getElementById("wordCount").innerText = `${wordCount} / 100 từ`;
    }
    
    // kiểm tra thay đổi loại sản phẩm dự kiến
    document.getElementById('sanPhamDuKien').addEventListener('change', function () {
        loadSPDuKien();
    });
    
    var ketQuaKhiNghiemThu = document.getElementById("ketqua");
    
    function loadSPDuKien() {
        var selectedValue = document.getElementById('sanPhamDuKien').value;
        
        if (selectedValue === "Bài báo thuộc danh mục  SCIE, SSCI, AHCI có thứ hạng theo WoS") {
            document.getElementById('chatLuong-form').style.display = "unset";
            document.getElementById('chatLuong').value = "";
            document.getElementById('chatLuong').innerHTML =
                '<option value="" selected disabled>-- Chọn chất lượng --</option>' +
                '<option value="WoS Q1">WoS Q1</option>' +
                '<option value="WoS Q2">WoS Q2</option>' +
                '<option value="WoS Q3">WoS Q3</option>' +
                '<option value="WoS Q4">WoS Q4</option>';
        } else if (selectedValue === "Bài báo thuộc danh mục Scopus (theo Scimago)") {
            document.getElementById('chatLuong-form').style.display = "unset";
            document.getElementById('chatLuong').value = "";
            document.getElementById('chatLuong').innerHTML =
                '<option value="" selected disabled>-- Chọn chất lượng --</option>' +
                '<option value="Scopus Q1">Scopus Q1</option>' +
                '<option value="Scopus Q2">Scopus Q2</option>' +
                '<option value="Scopus Q3">Scopus Q3</option>' +
                '<option value="Scopus Q4">Scopus Q4</option>';
        } else if (selectedValue === "Bài báo đăng hội nghị quốc tế uy tín được đánh chỉ mục bởi WoS hoặc Scopus") {
            document.getElementById('chatLuong-form').style.display = "unset";
            document.getElementById('chatLuong').value = "";
            document.getElementById('chatLuong').innerHTML =
                '<option value="" selected disabled>-- Chọn chất lượng --</option>' +
                '<option value="Có báo cáo (báo cáo viên thuộc UEF)">Có báo cáo (báo cáo viên thuộc UEF)</option>' +
                '<option value="Không có báo cáo">Không có báo cáo</option>';
        } else if (selectedValue === "Bài báo đăng tạp chí thuộc Hội đồng Giáo sư Nhà nước") {
            document.getElementById('chatLuong-form').style.display = "unset";
            document.getElementById('chatLuong').value = "";
            document.getElementById('chatLuong').innerHTML =
                '<option value="" selected disabled>-- Chọn chất lượng --</option>' +
                '<option value="Tạp chí được tính 1 điểm + sản phẩm đào tạo">Tạp chí được tính 1 điểm + sản phẩm đào tạo</option>' +
                '<option value="Tạp chí được tính 1 điểm">Tạp chí được tính 1 điểm</option>' +
                '<option value="Tạp chí được tính từ 0,5 đến 0,75 điểm">Tạp chí được tính từ 0,5 đến 0,75 điểm</option>';
        } else {
            document.getElementById('chatLuong-form').style.display = "none";
            document.getElementById('chatLuong').value = "Trống";
        }
        
        loadDinhMucKinhPhi();
        
        ketQuaKhiNghiemThu.style.display = "block";
        ketQuaKhiNghiemThu.innerHTML = `<label>Tiết chuẩn khi nghiệm thu:</label> <label id="tietchuan">0</label>;
                            <label>Điểm:</label> <label id="diem">10</label>`;
    }
    
    function loadDinhMucKinhPhi() {
        var selectedValue = document.getElementById('sanPhamDuKien').value;
        var selectedChatLuong = document.getElementById('chatLuong').value;
        
        var kinhPhi = 0;
        
        if (selectedValue == "Bài báo thuộc danh mục  SCIE, SSCI, AHCI có thứ hạng theo WoS") {
            if (selectedChatLuong == "WoS Q1") {
                kinhPhi = 100000000;
            } else if (selectedChatLuong == "WoS Q2") {
                kinhPhi = 80000000;
            } else if (selectedChatLuong == "WoS Q3") {
                kinhPhi = 60000000;
            } else if (selectedChatLuong == "WoS Q4") {
                kinhPhi = 48000000;
            }
        } else if (selectedValue == "Bài báo thuộc danh mục Scopus (theo Scimago)") {
            if (selectedChatLuong == "Scopus Q1") {
                kinhPhi = 55000000;
            } else if (selectedChatLuong == "Scopus Q2") {
                kinhPhi = 45000000;
            } else if (selectedChatLuong == "Scopus Q3") {
                kinhPhi = 35000000;
            } else if (selectedChatLuong == "Scopus Q4") {
                kinhPhi = 25000000;
            }
        } else if (selectedValue == "Bài báo đăng hội nghị quốc tế uy tín được đánh chỉ mục bởi WoS hoặc Scopus") {
            if (selectedChatLuong == "Có báo cáo (báo cáo viên thuộc UEF)") {
                kinhPhi = 18000000;
            } else if (selectedChatLuong == "Không có báo cáo") {
                kinhPhi = 15000000;
            }
        } else if (selectedValue == "Bài báo đăng trên tạp chí Phát triển và Hội nhập (UEF) viết bằng Tiếng Anh") {
            kinhPhi = 12000000;
        } else if (selectedValue == "Bài báo đăng tạp chí thuộc Hội đồng Giáo sư Nhà nước") {
            if (selectedChatLuong == "Tạp chí được tính 1 điểm + sản phẩm đào tạo") {
                kinhPhi = 18000000;
            } else if (selectedChatLuong == "Tạp chí được tính 1 điểm") {
                kinhPhi = 15000000;
            } else if (selectedChatLuong == "Tạp chí được tính từ 0,5 đến 0,75 điểm") {
                kinhPhi = 10000000;
            }
        } else if (selectedValue == "Đề tài NCKH có sản phẩm được ứng dụng, chuyển giao công nghệ (do HĐT đặt hàng).") {
            kinhPhi = 10000000;
        }
        
        document.getElementById('kinhPhi').value = kinhPhi
        document.getElementById('kinhPhi').setAttribute('title', formatCurrency(kinhPhi));
    }
    
    
    ////alert(_idUser);
    async function getData() {
        var timeline = document.getElementById("timeline").value;
        await fetch('https://localhost:44364/api/DanhMucXetDuyetSinhVien/Get-by-userid?userid=' + _idUser + "&startTimes=" + timeline, {
              headers: {
                  'Authorization': 'Bearer ' + _token,
                  'Content-Type': 'application/json'
              }
        })
            .then(response => response.json())
            .then(data => {
                var tongTien = 0;
                var stt = 1;
                const tbody = document.querySelector('#example1 tbody');
                tbody.innerHTML = "";
                data.forEach(function (row) {
                    ////////alert(row.groupUser);
                    if (row.status == "Đã nộp hồ sơ") {
                        txtcolor = "rgba(77, 77, 79, 1)";
                        bgcolor = "rgba(77, 77, 79, 0.07)";
                    } else if (row.status == "Đã nhận hồ sơ") {
                        txtcolor = "rgba(27, 162, 180, 1)";
                        bgcolor = "rgba(27, 162, 180, 0.07)";
                    } else if (row.status == "Đã gửi phản biện") {
                        txtcolor = "rgba(16, 117, 187, 1)";
                        bgcolor = "rgba(16, 117, 187, 0.07)";
                    } else if (row.status == "Không tài trợ") {
                        txtcolor = "rgba(200, 16, 47, 1)";
                        bgcolor = "rgba(200, 16, 47, 0.07)";
                    } else if (row.status == "Nộp lại/Chỉnh sửa") {
                        txtcolor = "rgba(200, 16, 47, 1)";
                        bgcolor = "rgba(200, 16, 47, 0.07)";
                    } else {
                        txtcolor = "rgba(42, 148, 70, 1)";
                        bgcolor = "rgba(42, 148, 70, 0.07)";
                    }

                    if (row.status_hopDong == "Chủ nhiệm kiểm tra, nộp lại hồ sơ và hợp đồng") {
                        txtcolor_hopDong = "rgba(77, 77, 79, 1)";
                        bgcolor_hopDong = "rgba(77, 77, 79, 0.07)";
                    } else if (row.status_hopDong == "Đã nộp hồ sơ hoàn chỉnh + hợp đồng") {
                        txtcolor_hopDong = "rgba(16, 117, 187, 1)";
                        bgcolor_hopDong = "rgba(16, 117, 187, 0.07)";
                    } else if (row.status_hopDong == "Không tài trợ") {
                        txtcolor_hopDong = "rgba(200, 16, 47, 1)";
                        bgcolor_hopDong = "rgba(200, 16, 47, 0.07)";
                    } else {
                        txtcolor_hopDong = "rgba(42, 148, 70, 1)";
                        bgcolor_hopDong = "rgba(42, 148, 70, 0.07)";
                    }

                    if (row.status_nghiemThu == "Đăng ký nghiệm thu/gia hạn/hủy") {
                        txtcolor_nghiemThu = "rgba(77, 77, 79, 1)";
                        bgcolor_nghiemThu = "rgba(77, 77, 79, 0.07)";
                    } else if (row.status_nghiemThu == "Thông báo: Đến thời hạn nghiệm thu") {
                        txtcolor_nghiemThu = "rgba(27, 162, 180, 1)";
                        bgcolor_nghiemThu = "rgba(27, 162, 180, 0.07)";
                    } else if (row.status_nghiemThu == "Đã gửi hội đồng nghiệm thu") {
                        txtcolor_nghiemThu = "rgba(16, 117, 187, 1)";
                        bgcolor_nghiemThu = "rgba(16, 117, 187, 0.07)";
                    } else if (row.status_nghiemThu == "Thanh lý hợp đồng (đề tài đã nghiệm thu ĐẠT)") {
                        txtcolor_nghiemThu = "rgb(18,82,124)";
                        bgcolor_nghiemThu = "rgb(255,255,255)";
                    } else if (row.status_nghiemThu == "Thanh lý HỦY đề tài") {
                        txtcolor_nghiemThu = "rgba(200, 16, 47, 1)";
                        bgcolor_nghiemThu = "rgba(200, 16, 47, 0.07)";
                    } else if (row.status_nghiemThu == "Nộp lại/chỉnh sửa hồ sơ nghiệm thu, gia hạn, hủy") {
                        txtcolor_nghiemThu = "rgba(200, 16, 47, 1)";
                        bgcolor_nghiemThu = "rgba(200, 16, 47, 0.07)";
