<script>
  document.getElementById("click-down").addEventListener("click", function () {
    var dvct = document.getElementById("selectedKhoa").textContent;
    toastr.info("Đang tải xuống minh chứng!");
    fetch("https://localhost:44364/api/DanhMucXetDuyetSinhVien/Download_minhchung?dvct=" + encodeURIComponent(dvct), {
      headers: {
        'Authorization': 'Bearer ' + _token,
        'Content-Type': 'application/json'
      }
    })
      .then(response => {
        if (!response.ok) {
          throw new Error("Có lỗi xảy ra khi gọi API.");
        }
        return response.blob();
      })
      .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = dvct + ".zip";
        link.click();
        window.URL.revokeObjectURL(url);
      })
      .catch(error => {
        console.error("Lỗi: ", error);
      });
  });
</script>


<script>
  var selectedFilesArray = []; // Mảng chứa danh sách file đã chọn

  document.addEventListener("DOMContentLoaded", function () {

    var timeline = document.getElementById("timeline");
    timeline.addEventListener("change", function () {
      ////alert("a");
      getData();

    });
    getData();
    function getData() {
      var timeline = document.getElementById("timeline").value;
      var Khoa = "";
      //alert(Khoa);
      if (_quyen == "Quyền duyệt 1" || _quyen == "Quyền duyệt 2") {
        Khoa = "";
      } else {
        Khoa = "";
      }
      $.ajax({
        "url": "https://localhost:44364/api/DanhMucXetDuyetSinhVien/Get-all?quyen=" + _quyen + "&startTimes=" + timeline,
        "headers": {
          "Authorization": "Bearer " + _token,
          "Content-Type": "application/json"
        },
        "success":
          function (data) {
            var tbody = $("#example1 tbody");
            $.each(data, function (index, row) {

              if (row.userId.includes(Khoa)) {
                var txtcolor, bgcolor;
                var txtcolor_hopDong, bgcolor_hopDong;
                var txtcolor_nghiemThu, bgcolor_nghiemThu;
                if (row.status == "Đã nộp hồ sơ") {
                  txtcolor = "rgba(77, 77, 79, 1)";
