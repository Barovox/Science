  function formatDatetimeNow() {
    const date = new Date();
    const day = date.getDate();
    const month = date.getMonth() + 1;
    const year = date.getFullYear();
    const hours = date.getHours();
    const minutes = date.getMinutes();
    const seconds = date.getSeconds();
  
    // 15062025153928
    return `${day.toString().padStart(2, "0")}${month
      .toString()
      .padStart(2, "0")}${year.toString().padStart(4, "0")}${hours
      .toString()
      .padStart(2, "0")}${minutes.toString().padStart(2, "0")}${seconds
      .toString()
      .padStart(2, "0")}`;
  };
  
  function handleAdminFileSelected() {
    var fileInput = document.getElementById('adminFileRes');
    var files = fileInput.files;
    const userId = document.getElementById("userId").value;
    const tenBaiBao = formatDatetimeNow();
    
    const maxFileSize = 10 * 1024 * 1024; // 10MB
    
    if (files.length === 0) {
      toastr.warning('Vui lòng chọn (các) tệp tin để tải lên.');
      return;
    }
    
    let uploadPromises = []; // Mảng chứa các Promise file upload
    
    Array.from(files).forEach(file => {
      // Kiểm tra dung lượng file
      if (file.size > maxFileSize) {
        toastr.error(`Tệp tin ${file.name} vượt quá giới hạn dung lượng 10MB.`);
        return;
      }
      
      // Tạo FormData để upload file
      let formData = new FormData();
      formData.append('file', file);
      formData.append('fileName', "admin_" + file.name);
      formData.append('userId', userId);
      formData.append('valuetenbaibao', sanitizeFileName(tenBaiBao));
      
      let uploadPromise = new Promise((resolve, reject) => {
        $.ajax({
          url: '/Article/SaveFile',
          type: 'POST',
          data: formData,
          processData: false, // Không xử lý dữ liệu
          contentType: false, // Không thiết lập tiêu đề content-type
          success: function (result) {
            if (result.success) {
              resolve(result.filePath);
            } else {
              reject('Tải lên thất bại.');
            }
          },
          error: function () {
            reject('Đã xảy ra lỗi khi tải lên.');
          }
        });
      });
      
      uploadPromises.push(uploadPromise); // Thêm Promise vào mảng
    });
    
    // Khi tất cả các file đã upload 
    Promise.all(uploadPromises)
      .then(filePaths => {
        // Lọc ra những file chưa tồn tại trong mảng selectedFilesArray
        let newFiles = filePaths.filter(filePath => {
          // Kiểm tra file (đường dẫn) có tồn tại trong selectedFilesArray không
          let fileName = filePath.split('/').pop(); // Lấy tên file từ đường dẫn
          if (selectedFilesArray.includes(filePath)) {
            toastr.warning(`Đã cập nhật tệp ${fileName}.`);
            return false; // Nếu file đã tồn tại, không thêm vào
          }
          return true; // Nếu file chưa tồn tại, thêm vào
        });
        if (newFiles.length > 0) {
          // Cập nhật lại danh sách file đã chọn và hiển thị
          selectedFilesArray = selectedFilesArray.concat(newFiles);
          toastr.success('Tải lên thành công.');
          // Gọi API cập nhật data ở Db
          updateAdminFileToDb();
          // Hiển thị danh sách file đã upload thành công
          displayAdminFilesUploaded(selectedFilesArray);
        } else {
          // toastr.warning('Không có file mới nào được thêm vào.');
        }
      })
      .catch(error => {
        toastr.error(error);
      });
  }
  
