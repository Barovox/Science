    }

    const fileDiv = document.createElement('div');
    fileDiv.className = 'col-8 file-item';

    const fileLink = document.createElement('a');
    fileLink.href = fileUrl;
    fileLink.textContent = shortenFileName(fileUrl.split('/').pop()); // Hiển thị tên file đã rút gọn
    fileLink.target = '_blank';
    fileLink.className = 'd-block';
    
    const fileStatusSpan = document.createElement('span');
    fileStatusSpan.id = `file-status-${fileIndex}`;
    
    fileDiv.appendChild(fileLink);
    fileDiv.appendChild(fileStatusSpan);
    
    if (batKiemDuyet) {
      @* TODO: Thêm nút kiểm duyệt file (class col-3) ở đây *@
      const actionDiv = document.createElement('div');
      actionDiv.className = 'col-4 btn-group';
      actionDiv.style.display = 'block';
      
