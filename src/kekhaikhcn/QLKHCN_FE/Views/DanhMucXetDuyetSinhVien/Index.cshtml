      approveBtn.setAttribute('type', 'button');
      approveBtn.setAttribute('onclick', `changeFileStatus(${fileIndex}, 1)`);
      
      const rejectBtn = document.createElement('button');
      rejectBtn.className = 'btn btn-danger';
      rejectBtn.textContent = 'Từ chối';
      rejectBtn.setAttribute('type', 'button');
      rejectBtn.setAttribute('onclick', `changeFileStatus(${fileIndex}, 0)`);
      
      actionDiv.appendChild(approveBtn);
      actionDiv.appendChild(rejectBtn);
      
      container.appendChild(fileDiv);
      container.appendChild(actionDiv);
    } else {
      container.appendChild(fileDiv);
    }
  }
  
  function shortenFileName(fileName, maxLength = 25) {
    // Kiểm tra độ dài fileName, nếu nhỏ hơn hoặc bằng maxLength thì không cần rút gọn
    if (fileName.length <= maxLength) return fileName;

    const extIndex = fileName.lastIndexOf('.'); // Lấy vị trí dấu chấm cuối cùng (phần mở rộng file)
    const extension = extIndex !== -1 ? fileName.slice(extIndex) : ''; // Phần mở rộng file (nếu có)
    const baseName = fileName.slice(0, extIndex); // Phần tên trước dấu chấm

    // Giữ lại 21 ký tự đầu và 11 ký tự cuối, giữa là '...'
    const start = baseName.slice(0, 9);
    const end = baseName.slice(-6);

    return `${start}...${end}${extension}`;
  }
  
